{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cegeka-nordic.example/schemas/odps-data-product.schema.json",
  "title": "Data Product (Open Data Product Standard subset)",
  "description": "Packaging layer that groups one or more ODCS data contracts into a consumable Gold Enterprise Data Product, modeled on the Bitol Open Data Product Standard (ODPS). Generated by governance_core/generate_odps_product.py.",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "name", "status", "version", "domain", "owner", "outputPorts"],
  "properties": {
    "apiVersion": { "type": "string", "const": "bitol.io/odps/v1alpha1" },
    "kind": { "type": "string", "const": "DataProduct" },
    "id": { "type": "string", "pattern": "^urn:ent:domain:[a-z0-9_-]+:dataproduct:[a-z0-9_-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated", "retired"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "domain": { "type": "string" },
    "tier": { "type": "string", "enum": ["bronze", "gold", "platinum"] },
    "owner": {
      "type": "object",
      "required": ["name", "email"],
      "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" } }
    },
    "outputPorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "contractId", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "contractId": { "type": "string", "description": "URN of the backing ODCS data contract (metadata.id)." },
          "type": { "type": "string", "enum": ["table", "view", "api", "file"] },
          "platform": { "type": "string", "enum": ["databricks", "fabric", "snowflake", "other"] },
          "location": { "type": "string", "description": "Platform-native locator, e.g. a Unity Catalog three-part name or a Fabric lakehouse table path." }
        }
      }
    },
    "consumptionChannels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["dashboard", "api", "notebook", "ml_model"] }
        }
      }
    },
    "slaRefs": {
      "type": "array",
      "items": { "type": "string", "description": "References to service_level_agreement blocks on the backing contracts." }
    },
    "supportChannel": { "type": "string" }
  }
}
