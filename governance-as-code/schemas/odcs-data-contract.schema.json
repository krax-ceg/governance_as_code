{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cegeka-nordic.example/schemas/odcs-data-contract.schema.json",
  "title": "Data Contract (Open Data Contract Standard subset)",
  "description": "Core-10-enforcing subset of the Open Data Contract Standard (ODCS, bitol.io/odcs). Generated by governance_core/generate_odcs_contract.py and validated in CI before a contract is promoted Bronze -> Gold. See core10-and-31-attribute-framework.md for the full field catalogue.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "accountability", "schema"],
  "properties": {
    "apiVersion": { "type": "string", "const": "bitol.io/odcs/v1alpha1" },
    "kind": { "type": "string", "const": "DataContract" },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^urn:ent:domain:[a-z0-9_-]+:product:[a-z0-9_-]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status": { "type": "string", "enum": ["draft", "active", "deprecated", "retired"] },
        "source_system_id": { "type": "string" },
        "data_residency_region": { "type": "string" }
      }
    },
    "accountability": {
      "type": "object",
      "required": ["domain", "data_owner", "data_steward", "classification", "criticality", "support_channel"],
      "properties": {
        "domain": { "type": "string" },
        "data_owner": {
          "type": "object",
          "required": ["name", "email"],
          "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" } }
        },
        "data_steward": {
          "type": "object",
          "required": ["name", "email"],
          "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" } }
        },
        "classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
        "criticality": { "type": "string", "enum": ["tier-1", "tier-2", "tier-3"] },
        "support_channel": { "type": "string" },
        "team": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "members": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "properties": {
        "business_glossary_link": { "type": "string" },
        "business_definition": { "type": "string" },
        "calculation_logic": { "type": "string" },
        "units_of_measurement": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "effective_from": { "type": "string", "format": "date" },
        "deprecation_date": { "type": "string", "format": "date" },
        "superseded_by": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "grain_keys": { "type": "array", "items": { "type": "string" } },
        "source_feeds": { "type": "array", "items": { "type": "string" } },
        "partition_keys": { "type": "array", "items": { "type": "string" } },
        "primary_key": { "type": "array", "items": { "type": "string" } }
      }
    },
    "service_level_agreement": {
      "type": "object",
      "properties": {
        "update_frequency": { "type": "string" },
        "max_latency_minutes": { "type": "number", "minimum": 0 },
        "target_availability_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "quality_rules": {
      "type": "object",
      "properties": {
        "drift_thresholds": {
          "type": "object",
          "properties": {
            "ks_test_p_value_floor": { "type": "number" },
            "psi_warn": { "type": "number" },
            "psi_quarantine": { "type": "number" }
          }
        }
      }
    },
    "schema": {
      "type": "object",
      "required": ["type", "required", "properties"],
      "properties": {
        "type": { "type": "string", "const": "object" },
        "additionalProperties": { "type": "boolean" },
        "required": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "properties": { "type": "object" }
      }
    },
    "security_and_privacy": {
      "type": "object",
      "properties": {
        "pii_fields": { "type": "array", "items": { "type": "string" } },
        "masking_rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mask_type": { "type": "string" },
              "retention_period_days": { "type": "integer" }
            }
          }
        },
        "access_policy_ref": { "type": "string" }
      }
    }
  }
}
